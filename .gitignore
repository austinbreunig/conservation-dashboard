# Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# boco_county_boundary is the one source with no live endpoint (config/
# sources.yaml, adapter: static_file) -- it must be committed and built
# into the image (Dockerfile), unlike every other data/raw/*.geojson
# fixture, which is a git-ignored dev-only fallback for a live source.
!data/raw/boco_county_boundary.geojson

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Nix / direnv
.direnv/

# OS
.DS_Store

# Claude Code agent worktrees + local deploy state
.claude/worktrees/
.deploy-state.env
